# ─────────────────────────────────────────────────────────────────────────────
# You probably do not need this file.
#
# Settings normally live in config.json, written by the setup screen at
# http://localhost:8080/setup. Start the server and go there instead.
#
# This file exists for two cases:
#
#   1. DEPLOYING. The setup screen only opens on the machine running the
#      server, so on a host like Render or Fly you set these as environment
#      variables in the host's dashboard instead. These are the names to use.
#
#   2. You would simply rather edit a text file. Copy this to `.env` and fill
#      it in; the setup screen will show the values and let you change them.
#
# A real environment variable always wins over config.json, so a host's
# dashboard is always in charge of a deployed server.
# ─────────────────────────────────────────────────────────────────────────────

# ── The business ─────────────────────────────────────────────── GUIDE §2 ─
BUSINESS_NAME=Bright Smile Dental
BUSINESS_TYPE=dental clinic
AGENT_NAME=Maya

# Must be a full IANA name: Asia/Kolkata, America/New_York, Europe/London.
# Not IST, not +05:30. Wrong value = appointments on the wrong day.
BUSINESS_TIMEZONE=Asia/Kolkata

# Leave blank for a default built from BUSINESS_NAME and AGENT_NAME.
AGENT_GREETING=

# ── The brain ────────────────────────────────────────────────── GUIDE §3 ─
# Free from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# native-audio: most human, follows the caller's language, ignores AGENT_LANGUAGE.
# The "live" models are half-cascade: faster and cheaper, but fix the language.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
AGENT_VOICE=Aoede
AGENT_LANGUAGE=en-IN

# ── The phone line ───────────────────────────────────────────── GUIDE §4 ─
# twilio (worldwide, self-serve) or exotel (India, KYC required)
TELEPHONY_PROVIDER=twilio

# If TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# If TELEPHONY_PROVIDER=exotel. A 401 on test means one of three things:
# wrong key/token, wrong account SID, or wrong region host.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com

# The https address this server is reachable at. ngrok in development.
# No trailing slash. Must be https — both providers refuse plain http.
PUBLIC_URL=

PORT=8080

# ── WhatsApp, optional ───────────────────────────────────────── GUIDE §5 ─
# Blank = no confirmations, and the agent never promises one.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Must be an APPROVED template of category UTILITY. Read GUIDE §5.4 first —
# the category cannot be changed after the template is created.
WHATSAPP_TEMPLATE_NAME=appointment_confirmation
WHATSAPP_TEMPLATE_LANG=en

# Used when a caller ID arrives without a country code, e.g. 09876543210.
WHATSAPP_COUNTRY_CODE=91

# ── Calendar, optional ───────────────────────────────────────── GUIDE §6 ─
# Blank = the agent takes messages instead of booking.
# The refresh token is easiest to obtain with the setup screen's Connect button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Hours and behaviour ──────────────────────────────────────── GUIDE §2 ─
OPEN_HOUR=9
CLOSE_HOUR=17
# 0=Sunday ... 6=Saturday
OPEN_DAYS=1,2,3,4,5
SLOT_MINUTES=30

# Announce that the call may be recorded. Required in some places — GUIDE §8.
RECORDING_DISCLOSURE=false

# How long a pause means the caller has finished. Lower is snappier.
SILENCE_MS=300

# ── Tuning you will rarely touch ──────────────────────────────────────────
# How loud the caller must be to cut the agent off mid-sentence, 0..1.
BARGE_THRESHOLD=0.06

# Print the whole system instruction at the start of each call. Useful once.
LOG_PROMPT=false
