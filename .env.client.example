# A dedicated (client-cloud) install. Copy to .env beside
# docker-compose.client.yml and fill in.
#
# ── Read this before filling it in ──────────────────────────────────────────
#
# Everything in this file ends up on a machine the client's own ops team has
# root on. That is the point of this mode, and it is also the constraint: a
# secret here is a secret they hold. Nothing platform-wide belongs in it.
#
# In particular, and never negotiable: NO platform OmniDimension key, NO
# Cashfree credentials, NO SUPERADMIN_EMAILS, NO cron secrets. The reseller key
# can move credits between every client's sub-account — one client with root
# would be reading every other client's minutes. The list is
# FORBIDDEN_IN_DEDICATED in src/lib/deploy/deployment.ts.

# ── Which install this is ───────────────────────────────────────────────────
# Given to you by `npx tsx scripts/register-deployment.ts --issue-key`, once.
DEPLOYMENT_ID="dep_acme"
DEPLOYMENT_KEY="dpk_…"
DEPLOYMENT_ORG_ID="org_…"
CONTROL_PLANE_URL="https://vaaniyantra.com"

# Immutable image tags. Never `latest` — this string is what the heartbeat
# reports, and it has to answer "what are you running".
VAANI_IMAGE="ghcr.io/OWNER/vaaniyantra-runtime:2026.09.03-4ab3175"
VAANI_VOICE_IMAGE="ghcr.io/OWNER/vaaniyantra-voice:2026.09.03-4ab3175"

# ── This box ────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL="https://voice.acme.example"
POSTGRES_PASSWORD=""
# openssl rand -hex 32. Every encrypted secret in THIS database is unreadable
# without it, and it is in no backup — losing it loses the integrations, not
# just the file.
SECRET_ENC_KEY=""
WEB_PORT="3000"
VOICE_PORT="8080"

# ── Firebase (public, build-inlined client config) ──────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Voice ───────────────────────────────────────────────────────────────────
# This install's OWN model key. Not the platform's.
GOOGLE_API_KEY=""
