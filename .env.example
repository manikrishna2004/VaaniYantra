# ─────────────────────────────────────────────────────────────
# Vaani AI — environment configuration
# Copy to `.env` and fill in. The app runs with the MOCK providers
# (no keys needed) until you set the real keys + flip USE_MOCK_* to false.
# ─────────────────────────────────────────────────────────────

# Database (Postgres). For a zero-setup local DB you can also point this
# at a docker postgres, Neon, or Supabase connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vaani?schema=public"

# Public base URL of the Next.js app (used to build Twilio webhook URLs).
APP_BASE_URL="http://localhost:3000"

# Public URL of the realtime voice/media WebSocket service (voice-server).
# In production this is wss://...; Twilio Media Streams connects here.
VOICE_WS_URL="ws://localhost:8080"
VOICE_WS_PORT="8080"

# ── Provider toggles ──────────────────────────────────────────
# Leave as "true" to run fully offline with deterministic mock providers.
USE_MOCK_TELEPHONY="false"
USE_MOCK_SPEECH="false"
USE_MOCK_LLM="false"

# ── LLM: Google Gemini (the agent "brain") ────────────────────
# Model used for realtime conversational turns (low latency).
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# ── Gemini Live (the realtime voice pipeline) ─────────────────
# true = one speech-to-speech Gemini Live session per call.
# false = cascade pipeline (Deepgram STT -> Gemini -> TTS).
USE_GEMINI_LIVE="true"
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-latest"
GEMINI_LIVE_VOICE="Aoede"
# Trailing silence (ms) before the model treats a turn as finished. Lower =
# snappier; too low clips mid-sentence pauses. Try 350-600.
GEMINI_LIVE_SILENCE_MS="300"
#
# Cost controls. Live re-processes the WHOLE session window on every turn, so a
# call's input bill grows with its number of turns and not just its length —
# roughly 80% of what a call costs is context being re-billed, mostly as audio
# tokens, which price 6x text. These are the knobs that move that number.
#
# Once the window passes TRIGGER it slides down to TARGET. TRIGGER counts the
# system instruction and tool declarations too, not just the conversation — a
# booking agent's fixed prefix is already ~3-4k tokens, so set TRIGGER well
# above it or compression fires in the first minute and the agent restarts the
# call, greeting included. Budget ~1000 audio tokens per minute of call.
GEMINI_LIVE_COMPRESSION_TRIGGER_TOKENS="16000"
GEMINI_LIVE_COMPRESSION_TARGET_TOKENS="8000"
# Audio kept before a detected speech start. 50ms with HIGH start-sensitivity
# opens a turn on line noise or the agent's own echo, and every spurious turn
# re-bills the window.
GEMINI_LIVE_PREFIX_PADDING_MS="150"
# Inbound silence gate: drop the frames where nobody is speaking instead of
# streaming them to Gemini. Ships OFF — it is the one setting here that touches
# live audio, so enable it per-environment after benchmarking barge-in.
GEMINI_LIVE_VAD_GATE="off"
# Watchdogs. A half-open carrier socket never fires 'close', so without these a
# dead call holds its Gemini session open — and billing — indefinitely.
LIVE_MEDIA_IDLE_MS="30000"
LIVE_MAX_CALL_MS="1800000"
VOICE_WS_HEARTBEAT_MS="15000"
# Agents kept on the ORIGINAL Live behaviour (wide window, knowledge inlined in
# the prompt, no silence gate), comma-separated ids. Normally empty: this is for
# pinning one agent to the old path while something is investigated, not a
# permanent home. An agent carrying its own Gemini key used to be excluded
# automatically; it no longer is — the demo runs the same path as everyone else,
# and its key is our money too.
LIVE_COST_OPT_OUT_AGENT_IDS=""

# ── Speech: Google Cloud Speech-to-Text + Text-to-Speech ──────
# Provide either GOOGLE_APPLICATION_CREDENTIALS (path to a service-account
# JSON) or GOOGLE_CLOUD_API_KEY. Used for STT and TTS in Indian languages.
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_CLOUD_API_KEY="your_google_cloud_api_key"
GOOGLE_CLOUD_PROJECT=""

# ── Telephony: Twilio ─────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# Default caller ID for outbound calls (E.164, e.g. +14155551234)
TWILIO_CALLER_ID="+10000000000"

# ── Feature flags ───────────────────────────────────────────────
# WhatsApp messaging (all transports). Default off: everything sends as SMS and
# WhatsApp is hidden across the product. Set true to re-enable the WhatsApp stack.
WHATSAPP_ENABLED=false

# Accounts (comma-separated emails) allowed to pick the demo practice types
# (real estate) and give an agent its own Gemini API key. Empty = nobody, which
# is correct for any ordinary deployment.
DEMO_VERTICAL_EMAILS=

# ── Billing cron ──────────────────────────────────────────────
# Bearer secret that lets scripts/overage-sweep.sh run the monthly overage
# sweep (POST /api/admin/overage) without a super-admin session. Generate with
# `openssl rand -hex 32`. Leave empty to disable the cron path entirely.
OVERAGE_CRON_SECRET=""

# Bearer secret for scripts/retention-sweep.sh and
# scripts/check-retention-freshness.sh (POST/GET /api/admin/retention).
# Generate with `openssl rand -hex 32`. Leave empty to disable the cron path.
#
# Worth setting: without it, data retention runs ONLY as a 6h interval inside
# the voice-server process, so if that process is down every org's retention
# window silently stops being enforced and nothing reports it.
RETENTION_CRON_SECRET=""

# ── Reseller voice platform (OmniDimension) ───────────────────
# Bearer secret for scripts/omni-reconcile.sh, which pulls billable minutes back
# from the reseller platform into the usage ledger (POST
# /api/admin/usage/reconcile). Generate with `openssl rand -hex 32`.
#
# ⚠ Worth setting the moment the first reseller account exists. For an org
# served by OmniDimension this pull IS the billing record — our own calls table
# never saw those minutes — so a reconciler that is not running means a month
# that cannot be closed (the overage sweep refuses, deliberately).
RECONCILE_CRON_SECRET=""

# Use the in-memory voice platform instead of talking to a provider. For local
# dev and tests, so nobody needs live reseller credentials to work on billing.
USE_MOCK_VOICE_PLATFORM="false"

# NOTE: the OmniDimension reseller API key is NOT an env var. It is stored
# encrypted in PlatformConfig (key `omnidimension_api_key`) and set from /admin,
# the same as the Cashfree credentials — a partner key that can move credits
# between client accounts does not belong in a file on the VM.

# ── Public API scopes ─────────────────────────────────────────
# Whether an API key with an EMPTY scope list is denied (true) or allowed with a
# warning (false, the default).
#
# ApiKey.scopes went unenforced for a long time, so every key created before
# enforcement carries []. Denying those on the deploy that shipped enforcement
# would have broken every live integration at once, so the rollout is:
#
#   1. deploy enforcement — [] allows, and logs "[api-keys] key … has no scopes"
#   2. npx tsx scripts/backfill-api-scopes.ts --apply   (grants every key ["*"])
#   3. watch the logs for a week; any warning is a key the backfill missed
#   4. set this to true
#
# Flipping it back is a restart, not a deploy — that is why it is env and not a
# code constant.
API_SCOPES_STRICT="false"

# ── Email (team invitations + sign-up verification) ───────────
# ⚠ NO LONGER OPTIONAL IN PRODUCTION. Invitations degrade gracefully without a
# backend — the owner is handed a link to send by hand. Sign-up does NOT: the
# verification code is the only way a new account can be created, so with
# neither of these set, email sign-up returns a 503 and nobody can register.
#
# Preferred: Resend, called over plain HTTP (no SDK to install).
RESEND_API_KEY=""
# Alternative: any SMTP server, e.g. "smtps://user:pass@smtp.example.com:465".
# Requires `npm i nodemailer`, which is NOT a dependency of this project.
SMTP_URL=""
# The From address on outgoing mail — invitations AND sign-up codes.
#
# Defaults to the business address published on /privacy and /contact. Its
# DOMAIN must be verified with your provider (SPF + DKIM), or messages are
# rejected outright by Resend and spam-foldered over SMTP. For sign-up codes
# that is not degraded delivery, it is a customer who cannot register at all.
MAIL_FROM="VaaniYantra <info@vaaniyantra.com>"
# Where the public "tell us what you need" form (/contact) delivers. Point it at
# a shared inbox if more than one person should see enquiries. Defaults to
# info@vaaniyantra.com.
ENQUIRY_TO=""

# ── Who may create an account ─────────────────────────────
# Sign-up is closed while this is anything but "off" — an unset value means ON,
# because the first boot after a deploy is exactly when an unprotected sign-up
# form would be found. Refused visitors are sent to /contact.
#
# It never locks out existing members, anyone holding a live team invitation, or
# a SUPERADMIN_EMAILS address, so turning it on is not an outage.
#
# The database setting written from /admin OVERRIDES this, so opening sign-up to
# everyone later is a toggle in the console rather than a redeploy.
INVITE_ONLY="on"
# Addresses let in without a team invitation, comma-separated. "@domain.com"
# admits a whole domain. Merged with (not replaced by) the list managed in
# /admin — this one is the seed that exists before the database does.
ACCESS_ALLOWLIST=""

# ── Prepaid credits ─────────────────────────────────────────────────────────
#
# Whether a clinic must have bought minutes before its agents will answer.
#
# "on"  — calls run against the prepaid balance, plus a 10% tolerance past it.
#         Past that the line stops answering until the clinic tops up. The
#         tolerance minutes are real minutes and are invoiced with next month's
#         sweep, exactly like any other uncovered usage.
# "off" — the default, and the only safe default: every org onboarded before
#         credits existed has a zero balance, so arming this by default would
#         take all of them off the air on the deploy that shipped it. Usage past
#         the balance is still billed; it is simply never blocked.
#
# Only ever applies to the per-minute plans. A clinic on a retired monthly plan
# bought an allowance, not credits, and is never gated.
#
# The database setting (PlatformConfig "credits_required") OVERRIDES this, so
# arming the gate once the live accounts have credits is a config change rather
# than a redeploy.
REQUIRE_PREPAID_CREDITS="off"

# ── Patient chatbot OTP ───────────────────────────────────────
# Extra secret mixed into the one-time-code hash, so a database dump cannot be
# used to replay a live code. Generate with `openssl rand -hex 32`. Falls back
# to the platform encryption key when unset.
PORTAL_OTP_PEPPER=""

# ── Sign-up email OTP ─────────────────────────────────────────
# The same idea for the codes that verify a new operator's email address, kept
# separate from the patient pepper so rotating one cannot invalidate the other's
# live codes. Generate with `openssl rand -hex 32`. Falls back to the platform
# encryption key when unset.
EMAIL_OTP_PEPPER=""

# ── Search engines ────────────────────────────────────────────
# Google Search Console verification token, WITHOUT the surrounding meta tag —
# just the content value. Optional.
#
# Prefer verifying by DNS TXT record instead: a domain property covers www and
# http variants too, and it takes effect immediately rather than waiting on a
# full rebuild and deploy. This exists for the HTML-tag method when DNS is not
# convenient. Unset = no tag is emitted.
GOOGLE_SITE_VERIFICATION=""

# ── Misc ──────────────────────────────────────────────────────
# Where uploaded knowledge-base files are stored on disk (dev).
STORAGE_DIR="./storage"



# ── Which install is this? (Phase 7/8) ────────────────────────
# The same image runs in two places, and the difference is read at RUNTIME —
# never at build time, or a client image built once in CI would carry `shared`
# onto every client's box and the admin guard would silently do nothing.
#
#   shared     our cloud. Everything on. The default when unset.
#   dedicated  a client's own cloud, where their ops team has root:
#              every /api/admin route answers 404, and the install is refused
#              if its database holds an organisation other than its own.
#
# Leave DEPLOYMENT_MODE unset on the shared VM. Set the rest there anyway: the
# shared cloud is registered as `dep_vaani_cloud` and heartbeats to ITSELF, so
# the signing, replay and entitlement paths are exercised in production before
# any client depends on them.
DEPLOYMENT_MODE=""
DEPLOYMENT_ID=""
# Issued once by `npx tsx scripts/register-deployment.ts --id=… --issue-key`.
# Encrypted at rest on our side, not hashed — an HMAC has to be recomputed —
# which is why it is shown exactly once and never read back out.
DEPLOYMENT_KEY=""
# Dedicated installs only: the single organisation this box may serve.
DEPLOYMENT_ORG_ID=""
# Where the install polls. Outbound only — nothing ever dials INTO a deployment,
# so no client has to open a firewall for us and we never become a route into
# their network.
CONTROL_PLANE_URL="https://vaaniyantra.com"
