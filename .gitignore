# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env / secrets (never commit anything but the placeholdered example)
.env
.env.*
!.env.example
# The client-cloud template. Placeholders only, and it has to ship with the
# compose file it is copied next to.
!.env.client.example
Exotel.env
# Gateway/provider credentials dropped in the repo root by hand. Named
# explicitly AND by pattern — a key pasted into the working tree is one
# `git add -A` away from being published.
Cashfree_APIKey.csv
*APIKey*
*apikey*
*api-key*

# Keep application source code for API-key management
!src/components/ApiKeysManager.tsx
!src/lib/api-keys.ts
!src/app/(app)/settings/api-keys/
!src/app/(app)/settings/api-keys/**
*_secret*
*credentials*
*service-account*.json
*credentials*.json

# deploy artifacts
*.tar.gz
tsconfig.tsbuildinfo

# database
*.db
*.db-journal
/prisma/dev.db

# uploads (knowledge base files stored on disk in dev)
/storage

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/
.idea/
*.stackdump

# Places API response cache (bulky, re-fetchable, costs nothing to discard)
sales/leads/.cache/
sales/leads/.cache-web/
sales/leads/drafts/
sales/leads/*.csv

# Generated by scripts/build-demo-stage.mjs (source + audio are tracked)
sales/demo-stage.html
sales/demo-stage-*.html
# ...but every .src.html IS the source, and glob * happily eats ".src".
!sales/demo-stage*.src.html

# Derived from the .m4a for transcription; regenerate with ffmpeg
sales/media/*.flac

# Video masters are large and derived; the web cut is rebuilt by ffmpeg
sales/media/*.mp4

# Freshly minted API key sitting on disk until it is moved into .env
.places-key.tmp

# Record of which clinics have been emailed — local state, and contact data
sales/leads/.sent.json

# Seeded design-canvas payload: ~2.5MB of editor code baked around the
# .dc.html sources next to it, and regenerable from them. The sources are the
# design; this is a build artifact.
design/*.html
!design/*.dc.html

# Starter Kit: build output and the buyer-facing dependency tree. The kit's
# source is tracked; the zip it packages into is rebuilt by product/package-kit.mjs.
product/dist/
product/vaani-starter-kit/node_modules/
product/vaani-starter-kit/.env
product/vaani-starter-kit/calls.json

# The paid artefact, served only to a valid download token by
# /api/kit/download. Rebuilt with `node product/package-kit.mjs`, so it is a
# build output rather than source — and it must never be in public/, where
# Next would serve it to anyone who guessed the name.
private/

# Additional generated artifacts
*.tsbuildinfo
coverage/
.nyc_output/

